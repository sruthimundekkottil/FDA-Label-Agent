# Copy to .env and fill in. .env is gitignored - never commit real keys.

# --- LLM (Gemini via its OpenAI-compatible endpoint) -------------------------
# Gemini OpenAI-compatible base URL, e.g. https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=
# API key for the provider above (for Gemini: an AI Studio key)
LLM_API_KEY=
# Model id as the provider names it, e.g. gemini-3.8-flash
LLM_MODEL=

# --- Agent adapter (agent/llm) -----------------------------------------------
# gemini | mock  (empty: gemini when a key and LLM_MODEL are set, otherwise mock)
LLM_PROVIDER=
# Native Gemini key (google-genai). Falls back to LLM_API_KEY when empty.
GEMINI_API_KEY=
# auto | record | replay | off  (replay = no network; a missing recording is an error)
LLM_CACHE_MODE=auto
# minimal | low | medium | high
LLM_THINKING_LEVEL=low
# Evals use 0 (project rule). Note: Google recommends 1.0 for Gemini 3 models.
LLM_TEMPERATURE=0

# --- Local models ------------------------------------------------------------
# Embedding model used for the vector index.
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Optional cross-encoder reranker (only used by the hybrid_rerank retriever).
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- openFDA -----------------------------------------------------------------
# Optional. Without a key openFDA is rate limited to 240 req/min / 1000 req/day.
OPENFDA_API_KEY=

# --- Misc --------------------------------------------------------------------
# Set to 1 to force the mock LLM even when a key is configured.
LLM_MOCK=0

# --- API (api/main.py) ---------------------------------------------------------
# If set, POST /ask needs the header X-API-Key with this value. Leave empty for no check.
AGENT_API_KEY=
# Questions per client IP per minute (0 = off)
RATE_LIMIT_PER_MINUTE=10
# /ask runs per UTC day across all clients (0 = off); each run uses at most 5 model calls
DAILY_CALL_CAP=200
# Agent runs at the same time
AGENT_CONCURRENCY=1
# 1 only behind your own reverse proxy: take the client IP from X-Forwarded-For
TRUST_PROXY_HEADERS=0
